# Required — supports both names to match `docker run -e API_KEY=...` from spec
GEMINI_API_KEY=
# API_KEY=   # alternative name

# Optional
GEMINI_MODEL=gemini-3.5-flash
STORE_DISPLAY_NAME=optibot-support-kb
ZENDESK_BASE_URL=https://support.optisigns.com
ZENDESK_LOCALE=en-us
CHUNK_MAX_TOKENS=400
CHUNK_OVERLAP_TOKENS=60
MAX_WORKERS=4
ARTICLE_LIMIT=0          # 0 = fetch all; set e.g. 40 for a quick test run
DRY_RUN=false

# Optional: push run artifact to GitHub (see README §Daily job)
GITHUB_TOKEN=
GITHUB_REPO=
